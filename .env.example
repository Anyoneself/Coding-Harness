# Required: create an API key in the DeepSeek platform.
DEEPSEEK_API_KEY=

# DeepSeek's OpenAI-compatible API endpoint and model.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_ALLOWED_MODELS=deepseek-v4-flash,deepseek-v4-pro

# Provider output and local workspace.
AGENT_MAX_OUTPUT_TOKENS=8192
AGENT_WORKSPACE=.

# PostgreSQL stores Workspace, Thread, Turn, Item, Checkpoint and event state.
DATABASE_URL=postgresql://my_agent:my_agent@127.0.0.1:5433/my_agent
POSTGRES_DB=my_agent
POSTGRES_USER=my_agent
POSTGRES_PASSWORD=my_agent
POSTGRES_PORT=5433

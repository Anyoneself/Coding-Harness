# Required: create an API key in the DeepSeek platform.
DEEPSEEK_API_KEY=

# DeepSeek's OpenAI-compatible API endpoint and model.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_ALLOWED_MODELS=deepseek-v4-flash,deepseek-v4-pro

# Thinking/tool-loop controls.
DEEPSEEK_THINKING=true
DEEPSEEK_REASONING_EFFORT=high
AGENT_MAX_ROUNDS=8
AGENT_MAX_OUTPUT_TOKENS=8192

# Codex-style local workspace tools.
AGENT_WORKSPACE=.
AGENT_ENABLE_WORKSPACE_TOOLS=true
AGENT_MAX_TOOL_OUTPUT_CHARS=20000
AGENT_MAX_WORKSPACE_FILE_BYTES=1000000
AGENT_COMMAND_TIMEOUT_SECONDS=30

# PostgreSQL stores persistent model history and structured execution events.
DATABASE_URL=postgresql://my_agent:my_agent@127.0.0.1:5433/my_agent
POSTGRES_DB=my_agent
POSTGRES_USER=my_agent
POSTGRES_PASSWORD=my_agent
POSTGRES_PORT=5433

# Milvus stores vectorized knowledge documents. Token is empty for local standalone mode.
MILVUS_ENABLED=true
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=my_agent_knowledge
AGENT_EMBEDDING_DIMENSION=256

# Optional: enables the web_search tool.
TAVILY_API_KEY=

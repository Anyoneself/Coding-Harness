# Required: create an API key in the DeepSeek platform.
DEEPSEEK_API_KEY=

# DeepSeek's OpenAI-compatible API endpoint and model.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_ALLOWED_MODELS=deepseek-v4-flash,deepseek-v4-pro

# Thinking/tool-loop controls.
DEEPSEEK_THINKING=true
DEEPSEEK_REASONING_EFFORT=high
AGENT_MAX_ROUNDS=8
AGENT_MAX_OUTPUT_TOKENS=8192

# Codex-style local workspace tools.
AGENT_WORKSPACE=.
AGENT_ENABLE_WORKSPACE_TOOLS=true
AGENT_MAX_TOOL_OUTPUT_CHARS=20000
AGENT_MAX_WORKSPACE_FILE_BYTES=1000000
AGENT_COMMAND_TIMEOUT_SECONDS=30

# Optional: enables the web_search tool.
TAVILY_API_KEY=
